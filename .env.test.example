# Copy to .env.test.local (gitignored, never commit it) and fill in.
#
# The API and E2E suites WRITE test rows (marked "hgtest") to this database and
# delete only those rows afterwards. Today this is the app's own Supabase DB.
# If left empty, DATABASE_URL / DIRECT_URL are read from .env.local or .env.
DATABASE_URL=
DIRECT_URL=

# Required: confirms you accept that the tests write to the database above.
TESTS_MAY_WRITE_TO_DATABASE=yes

# Optional
# FAKE_SERVICES_PORT=4599
# E2E_PORT=3100
# PW_CHANNEL=chrome

# Remote-DB tuning (defaults shown; see tests/README.md)
# TEST_TIMEOUT_MS=120000
# TEST_HOOK_TIMEOUT_MS=300000
# E2E_TEST_TIMEOUT_MS=240000
# E2E_EXPECT_TIMEOUT_MS=45000
# TEST_DB_CONNECTION_LIMIT=3
# TEST_DB_RETRIES=6

# Everything else (Cashfree, ST Courier, Brevo, PostHog, AUTH_SECRET, CRON_SECRET)
# is forced to dummy values and a local fake server by tests/helpers/env.ts.
