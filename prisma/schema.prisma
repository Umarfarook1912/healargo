generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  admin
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
}

enum WhatsAppLeadStatus {
  NEW
  CONTACTED
  ORDERED
  LOST
}

enum WhatsAppLeadContext {
  product
  combo
  cart
  checkout
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  passwordHash           String?
  phone                  String?
  image                  String?
  role                   UserRole  @default(user)
  addresses              Json      @default("[]")
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  orders         Order[]
  reviews        Review[]
  whatsappClicks WhatsAppClick[]

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  badge       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String
  shortDescription String?
  images           String[]  @default([])
  videos           String[]  @default([])
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id])
  variants         Json      @default("[]")
  tags             String[]  @default([])
  isActive         Boolean   @default(true)
  isBestSeller     Boolean   @default(false)
  isNewArrival     Boolean   @default(false)
  gstExempt        Boolean   @default(false)
  offerEnabled     Boolean   @default(false)
  offerStartsAt    DateTime?
  offerEndsAt      DateTime?
  seo              Json      @default("{}")
  averageRating    Float     @default(0)
  reviewCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reviews Review[]
  orders  OrderItem[]

  @@index([categoryId])
  @@index([isActive, isBestSeller])
  @@map("products")
}

model Combo {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  images        String[]  @default([])
  videos        String[]  @default([])
  price         Float
  originalPrice Float
  isActive      Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  items         Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("combos")
}

model Order {
  id                     String        @id @default(cuid())
  userId                 String?
  user                   User?         @relation(fields: [userId], references: [id])
  shippingAddress        Json
  pricing                Json
  status                 OrderStatus   @default(PENDING)
  paymentStatus          PaymentStatus @default(PENDING)
  cashfreeOrderId   String?
  cashfreePaymentId String?
  couponCode             String?
  attribution            Json?
  notes                  String?
  stockDecremented       Boolean       @default(false)
  trackingNumber         String?
  courier                String?
  trackingStatus         String?
  trackingLastCheckedAt  DateTime?
  trackingUpdatedAt      DateTime?
  shippedAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([cashfreeOrderId])
  @@index([trackingNumber])
  @@index([status, paymentStatus])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  variantId    String
  name         String
  variantLabel String
  image        String?
  price        Float
  quantity     Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  authorName String
  rating     Int
  body       String
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([isApproved])
  @@map("reviews")
}

model Coupon {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  description        String              @default("")
  discountType       CouponDiscountType  @default(PERCENTAGE)
  discountValue      Float
  validFrom          DateTime
  validTo            DateTime
  usageLimit         Int                 @default(0)
  timesUsed          Int                 @default(0)
  applicableProducts String[]            @default([])
  applicableVariants String[]            @default([])
  status             CouponStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([validFrom, validTo])
  @@map("coupons")
}

model Carousel {
  id             String   @id @default(cuid())
  imageUrl       String
  navigationLink String
  headline       String   @default("")
  subheadline    String   @default("")
  buttonText     String   @default("")
  altText        String   @default("")
  sortOrder      Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("carousels")
}

model MarketingVisit {
  id          String   @id @default(cuid())
  source      String
  medium      String   @default("")
  campaign    String   @default("")
  content     String   @default("")
  term        String   @default("")
  landingPath String   @default("")
  sessionKey  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sessionKey, source, medium, campaign, content, term, landingPath])
  @@index([source])
  @@index([sessionKey])
  @@map("marketing_visits")
}

model WhatsAppClick {
  id             String              @id @default(cuid())
  status         WhatsAppLeadStatus  @default(NEW)
  context        WhatsAppLeadContext
  pagePath       String
  items          Json
  estimatedTotal Float
  attribution    Json?
  sessionKey     String?
  userId         String?
  user           User?               @relation(fields: [userId], references: [id])
  userName       String?
  userEmail      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
  @@index([context])
  @@index([sessionKey])
  @@index([userId])
  @@index([createdAt])
  @@map("whatsapp_clicks")
}
